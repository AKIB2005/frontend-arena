{
  "name": "grantly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.19.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "analyze": "set ANALYZE=1&& vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "contrast": "node --experimental-strip-types scripts/contrast.ts",
    "check": "tsc --noEmit && npm run lint && npm test -- --run && npm run contrast && vite build",
    "format:check": "prettier --check src/App.tsx src/components/CommandPalette.tsx src/components/Layout.tsx src/index.css src/lib/matches.ts src/lib/motion.ts src/lib/ui-store.ts src/match.test.ts src/pages/Discover.tsx src/store.ts vitest.config.ts eslint.config.js .prettierrc"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource/dm-sans": "^5.1.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "react-tabs": "^6.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "postcss": "^8.4.45",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
